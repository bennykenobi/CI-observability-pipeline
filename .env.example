# Local development values only. Replace with deployed infrastructure values outside dev.
CI_OBS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ci_observability
CI_OBS_WEBHOOK_SECRET=replace-me
CI_OBS_WEBHOOK_AUTH_TOKEN=replace-me
CI_OBS_PUBSUB_TOPIC=ci-observability-ingestion
CI_OBS_GITHUB_API_URL=https://api.github.com
CI_OBS_GITHUB_APP_ID=123456
CI_OBS_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
CI_OBS_INITIAL_FETCH_DELAY_SECONDS=10
CI_OBS_GITHUB_FETCH_RETRY_ATTEMPTS=5
CI_OBS_GITHUB_FETCH_RETRY_INTERVAL_SECONDS=10
CI_OBS_MAX_INGESTION_MESSAGE_AGE_SECONDS=3600
CI_OBS_WEBHOOK_MAX_AGE_SECONDS=300
CI_OBS_WEBHOOK_FUTURE_SKEW_SECONDS=30
# Local Redis for development only. In GCP, use the Memorystore/private Redis URL.
CI_OBS_REPLAY_STORE_URL=redis://localhost:6379/0
CI_OBS_REPLAY_STORE_KEY_PREFIX=ci-obs:replay
# Local collector endpoint for development only. In GCP, point this at the deployed collector URL, for example:
# https://YOUR_COLLECTOR_SERVICE_URL/v1/traces
CI_OBS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
CI_OBS_OTEL_EXPORTER_OTLP_HEADERS=
